GEMINI_API_KEY=

# Identity verification (candidate interview gate)
# Min face-match confidence to pass (default 70)
IDENTITY_MIN_CONFIDENCE=70
# Production FaceNet service on Render (recommended — accurate, no Gemini required for face match)
# FACE_MATCH_SERVICE_URL=https://ai-interview-facenet.onrender.com
# FACE_MATCH_API_KEY=shared-secret-with-render-service
# FACE_MATCH_TIMEOUT_MS=90000
# FACE_MATCH_TOLERANCE is set on the Render service (default 0.85)
# Optional override model for ID-type + spoof assist (not required if FaceNet URL is set)
# GEMINI_IDENTITY_MODEL=gemini-2.0-flash
# FACE_MATCH_FORCE_CLOUD=1
# FACE_MATCH_FORCE_LOCAL=1

# Employee portal JWT signing (required in production — keep stable; rotating logs everyone out)
EMPLOYEE_AUTH_SECRET=

# Microsoft Entra ID SSO for Employee Portal
# Redirect URI to register in Azure: {NEXT_PUBLIC_APP_URL}/api/employee/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations
# MICROSOFT_REDIRECT_URI=https://your-domain/api/employee/auth/microsoft/callback

# SMTP credentials for real email sending
