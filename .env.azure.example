# Copy to .env.azure and fill in values for Azure Container Apps / docker compose.
# Build-time args (also set as docker build --build-arg):
#   NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, NEXT_PUBLIC_APP_URL

# --- Supabase (Postgres + Storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- App URL (must match Azure ingress / custom domain) ---
NEXT_PUBLIC_APP_URL=https://your-app.azurecontainerapps.io

# --- Auth & admin ---
EMPLOYEE_AUTH_SECRET=generate-a-long-random-string-here
ADMIN_PASSWORD=change-me

# --- AI (Gemini) ---
GEMINI_API_KEY=your-gemini-api-key

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# --- Container runtime (set automatically in Dockerfile; override only if needed) ---
CONTAINER=1
USE_SUPABASE_PRIMARY=1
DOCS_USE_CLOUD=1
UPLOADS_DIR=/app/uploads

# Optional: OpenAI if used elsewhere in the app
# OPENAI_API_KEY=
